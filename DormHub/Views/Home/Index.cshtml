@model DormHub.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome Banner -->
<div class="dh-welcome dh-fade">
    <div class="dh-welcome-glow"></div>
    <div class="dh-welcome-text">
        <h1>Witaj, <span>@User.Identity?.Name!</span> 👋</h1>
        <p data-pl="Oto aktualny stan Twojego akademika." data-en="Here's the current state of your dormitory.">
            Oto aktualny stan Twojego akademika.
        </p>
        <div class="dh-welcome-actions">
            <a href="/platnosci" class="dh-btn-white" data-pl="Zarządzaj płatnościami" data-en="Manage payments">Zarządzaj płatnościami</a>
            <a href="/usterki" class="dh-btn-outline" data-pl="Zgłoś usterkę" data-en="Report fault">Zgłoś usterkę</a>
        </div>
    </div>
    <div class="dh-ring" style="display:none;" id="semester-ring">
        <svg width="140" height="140" viewBox="0 0 100 100" style="transform:rotate(-90deg)">
            <circle cx="50" cy="50" r="40" stroke="#1A1A1A" stroke-width="8" fill="none"/>
            <circle cx="50" cy="50" r="40" stroke="#FF6B00" stroke-width="8" fill="none"
                    stroke-dasharray="251.2" stroke-dashoffset="62.8" stroke-linecap="round"
                    style="filter:drop-shadow(0 0 8px rgba(255,107,0,.5))"/>
        </svg>
        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;">
            <span style="font-size:1.4rem;font-weight:700;color:#fff;">75%</span>
            <span style="font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;" data-pl="Semestr" data-en="Semester">Semestr</span>
        </div>
    </div>
</div>

<!-- Karty statystyk -->
<div class="dh-stats-grid dh-fade dh-fade-1">

    @if (User.IsInRole("Admin"))
    {
        <!-- Wolne pokoje (admin) -->
        <div class="dh-card dh-card-hover" onclick="location.href='/pokoje'">
            <div class="dh-stat-card-corner"></div>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.75rem;">
                <div class="dh-stat-icon"><i class="fa-solid fa-door-open"></i></div>
                <span class="dh-badge dh-badge-green" data-pl="Wolne" data-en="Available">Wolne</span>
            </div>
            <div class="dh-stat-value">@Model.AvailableRooms</div>
            <div class="dh-stat-label" data-pl="Wolne pokoje" data-en="Available rooms">Wolne pokoje</div>
            <div class="dh-stat-sub">z @Model.TotalRooms <span data-pl="łącznie" data-en="total">łącznie</span></div>
        </div>
    }
    else
    {
        <!-- Mój pokój (mieszkaniec) -->
        <div class="dh-card dh-card-hover" onclick="location.href='/moj-pokoj'">
            <div class="dh-stat-card-corner"></div>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.75rem;">
                <div class="dh-stat-icon"><i class="fa-solid fa-bed"></i></div>
                <span class="dh-badge dh-badge-blue" data-pl="Zobacz" data-en="View">Zobacz</span>
            </div>
            @if (Model.HasRoom)
            {
                <div class="dh-stat-value" style="font-size:1.5rem;">@Model.MyRoomLabel</div>
                <div class="dh-stat-label" data-pl="Mój pokój" data-en="My room">Mój pokój</div>
                <div class="dh-stat-sub">
                    @Model.MyRoommates <span data-pl="współlokatorów" data-en="roommates">współlokatorów</span>
                </div>
            }
            else
            {
                <div class="dh-stat-value" style="font-size:1.5rem;">—</div>
                <div class="dh-stat-label" data-pl="Mój pokój" data-en="My room">Mój pokój</div>
                <div class="dh-stat-sub" data-pl="Brak przydziału" data-en="Not assigned">Brak przydziału</div>
            }
        </div>
    }

    <!-- Usterki -->
    <div class="dh-card dh-card-hover" onclick="location.href='/usterki'">
        <div class="dh-stat-card-corner"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.75rem;">
            <div class="dh-stat-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
            @if (Model.CriticalFaults > 0)
            {
                <span class="dh-badge dh-badge-red" data-pl="Krytyczne" data-en="Critical">Krytyczne</span>
            }
            else
            {
                <span class="dh-badge dh-badge-green" data-pl="OK" data-en="OK">OK</span>
            }
        </div>
        <div class="dh-stat-value">@Model.OpenFaults</div>
        <div class="dh-stat-label" data-pl="Otwarte usterki" data-en="Open faults">Otwarte usterki</div>
        @if (Model.CriticalFaults > 0)
        {
            <div class="dh-stat-sub" style="color:#ef4444;">
                <i class="fa-solid fa-circle-exclamation"></i>
                @Model.CriticalFaults <span data-pl="krytycznych" data-en="critical">krytycznych</span>
            </div>
        }
    </div>

    <!-- Wnioski -->
    <div class="dh-card dh-card-hover" onclick="location.href='/wnioski'">
        <div class="dh-stat-card-corner"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.75rem;">
            <div class="dh-stat-icon"><i class="fa-solid fa-clipboard-list"></i></div>
            @if (Model.PendingApplications > 0)
            {
                <span class="dh-badge dh-badge-yellow" data-pl="Oczekują" data-en="Pending">Oczekują</span>
            }
        </div>
        <div class="dh-stat-value">@Model.PendingApplications</div>
        <div class="dh-stat-label" data-pl="Oczekujące wnioski" data-en="Pending applications">Oczekujące wnioski</div>
    </div>

    <!-- Płatności -->
    <div class="dh-card dh-card-hover" onclick="location.href='/platnosci'">
        <div class="dh-stat-card-corner"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.75rem;">
            <div class="dh-stat-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            @if (Model.OverduePayments > 0)
            {
                <span class="dh-badge dh-badge-red" data-pl="Zaległe" data-en="Overdue">Zaległe</span>
            }
        </div>
        <div class="dh-stat-value">@Model.OverduePayments</div>
        <div class="dh-stat-label" data-pl="Zaległe płatności" data-en="Overdue payments">Zaległe płatności</div>
        @if (Model.PendingPayments > 0)
        {
            <div class="dh-stat-sub">
                @Model.PendingPayments <span data-pl="oczekujących" data-en="pending">oczekujących</span>
            </div>
        }
    </div>

</div>

<!-- Główna siatka -->
<div class="dh-grid-2-1 dh-fade dh-fade-2">

    <!-- Lewa kolumna -->
    <div style="display:flex;flex-direction:column;gap:1.5rem;">

        <!-- Ogłoszenia -->
        <div class="dh-card">
            <div class="dh-card-header">
                <div class="dh-card-title">
                    <i class="fa-solid fa-thumbtack"></i>
                    <span data-pl="Ogłoszenia" data-en="Announcements">Ogłoszenia</span>
                </div>
                <a href="/ogloszenia" class="dh-card-link" data-pl="Zobacz wszystkie" data-en="View all">Zobacz wszystkie</a>
            </div>

            @if (!Model.RecentAnnouncements.Any())
            {
                <p style="color:var(--muted);font-size:.88rem;" data-pl="Brak ogłoszeń." data-en="No announcements.">Brak ogłoszeń.</p>
            }
            else
            {
                @foreach (var a in Model.RecentAnnouncements)
                {
                    <div class="dh-ann-item">
                        <div class="dh-ann-icon">
                            <i class="fa-solid fa-@(a.IsPinned ? "thumbtack" : "bullhorn")"></i>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div class="dh-ann-title">
                                @a.Title
                                @if (a.Building != null)
                                {
                                    <span class="dh-ann-tag">@a.Building.Name</span>
                                }
                            </div>
                            <div class="dh-ann-body">@(a.Content.Length > 120 ? a.Content.Substring(0, 120) + "…" : a.Content)</div>
                            <div class="dh-ann-time"><i class="fa-regular fa-clock"></i> @a.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Tabela ostatnich usterek -->
        <div class="dh-card">
            <div class="dh-card-header">
                <div class="dh-card-title">
                    <i class="fa-solid fa-clipboard-list"></i>
                    <span data-pl="Otwarte usterki" data-en="Open faults">Otwarte usterki</span>
                </div>
                <a href="/usterki" class="dh-card-link" data-pl="Wszystkie" data-en="All">Wszystkie</a>
            </div>

            @if (!Model.RecentFaults.Any())
            {
                <p style="color:var(--muted);font-size:.88rem;" data-pl="Brak otwartych usterek 🎉" data-en="No open faults 🎉">Brak otwartych usterek 🎉</p>
            }
            else
            {
                <table class="dh-table">
                    <thead>
                        <tr>
                            <th data-pl="Pokój" data-en="Room">Pokój</th>
                            <th data-pl="Opis" data-en="Description">Opis</th>
                            <th data-pl="Data" data-en="Date">Data</th>
                            <th data-pl="Priorytet" data-en="Priority">Priorytet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.RecentFaults)
                        {
                            <tr>
                                <td class="td-mono">@f.Room?.RoomNumber</td>
                                <td class="td-bold">@(f.Description.Length > 45 ? f.Description.Substring(0, 45) + "…" : f.Description)</td>
                                <td class="td-muted">@f.ReportedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @{
                                        var bc = f.PriorityId switch {
                                            4 => "dh-badge-red",
                                            3 => "dh-badge-yellow",
                                            2 => "dh-badge-orange",
                                            _ => "dh-badge-gray"
                                        };
                                    }
                                    <span class="dh-badge @bc">@(f.Priority?.Name ?? "–")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Prawa kolumna – szybkie linki -->
    <div class="dh-fade dh-fade-3" style="display:flex;flex-direction:column;gap:1.5rem;">
        <div class="dh-card">
            <div class="dh-card-title" style="margin-bottom:1rem;">
                <i class="fa-solid fa-bolt"></i>
                <span data-pl="Szybki dostęp" data-en="Quick access">Szybki dostęp</span>
            </div>
            <div style="display:flex;flex-direction:column;gap:.6rem;">
                <a href="/usterki/dodaj" class="dh-btn dh-btn-ghost" style="justify-content:flex-start;">
                    <i class="fa-solid fa-plus" style="color:var(--orange);"></i>
                    <span data-pl="Nowa usterka" data-en="New fault">Nowa usterka</span>
                </a>
                <a href="/ogloszenia/dodaj" class="dh-btn dh-btn-ghost" style="justify-content:flex-start;">
                    <i class="fa-solid fa-bullhorn" style="color:var(--orange);"></i>
                    <span data-pl="Nowe ogłoszenie" data-en="New announcement">Nowe ogłoszenie</span>
                </a>
                <a href="/platnosci/dodaj" class="dh-btn dh-btn-ghost" style="justify-content:flex-start;">
                    <i class="fa-solid fa-wallet" style="color:var(--orange);"></i>
                    <span data-pl="Nowa płatność" data-en="New payment">Nowa płatność</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/wnioski" class="dh-btn dh-btn-ghost" style="justify-content:flex-start;">
                        <i class="fa-solid fa-clipboard-check" style="color:var(--orange);"></i>
                        <span data-pl="Wnioski do rozpatrzenia" data-en="Pending applications">Wnioski do rozpatrzenia</span>
                        @if (Model.PendingApplications > 0)
                        {
                            <span class="dh-nav-badge" style="margin-left:auto;">@Model.PendingApplications</span>
                        }
                    </a>
                }
            </div>
        </div>

        <!-- Ministat -->
        <div class="dh-card">
            <div class="dh-card-title" style="margin-bottom:1rem;">
                <i class="fa-solid fa-chart-pie"></i>
                <span data-pl="Obłożenie" data-en="Occupancy">Obłożenie</span>
            </div>
            @{
                var pct = Model.TotalRooms > 0 ? (int)((double)Model.OccupiedRooms / Model.TotalRooms * 100) : 0;
                var dashOffset = (int)(251.2 * (1 - pct / 100.0));
            }
            <div style="display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.5rem;padding:.5rem 0;">
                <div style="position:relative;width:110px;height:110px;">
                    <svg width="110" height="110" viewBox="0 0 100 100" style="transform:rotate(-90deg)">
                        <circle cx="50" cy="50" r="40" stroke="#1A1A1A" stroke-width="10" fill="none"/>
                        <circle cx="50" cy="50" r="40" stroke="#FF6B00" stroke-width="10" fill="none"
                                stroke-dasharray="251.2" stroke-dashoffset="@dashOffset" stroke-linecap="round"/>
                    </svg>
                    <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                        <span style="font-size:1.3rem;font-weight:700;color:#fff;">@pct%</span>
                    </div>
                </div>
                <div style="text-align:center;font-size:.82rem;color:var(--muted);">
                    @Model.OccupiedRooms / @Model.TotalRooms <span data-pl="pokoi zajętych" data-en="rooms occupied">pokoi zajętych</span>
                </div>
            </div>
        </div>
    </div>

</div>
@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <a class="btn btn-danger"
       asp-controller="Admin"
       asp-action="Index">
        Panel sterowania
    </a>
}
