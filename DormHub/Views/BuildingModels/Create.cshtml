@model DormHub.Models.BuildingModel
@{ ViewData["Title"] = "Dodaj budynek"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-building" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Dodaj budynek" data-en="Add building">Dodaj budynek</span></div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost"><i class="fa-solid fa-arrow-left"></i> <span data-pl="Powrót" data-en="Back">Powrót</span></a>
</div>

<div class="dh-card dh-fade dh-fade-1" style="max-width:580px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="dh-validation-summary"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Nazwa budynku" data-en="Building name">Nazwa budynku</label>
                <input asp-for="Name" class="dh-input" />
                <div class="dh-form-error"><span asp-validation-for="Name"></span></div>
            </div>
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Liczba pięter" data-en="Total floors">Liczba pięter</label>
                <input asp-for="TotalFloors" class="dh-input" type="number" min="1" />
            </div>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Adres" data-en="Address">Adres</label>
            <input asp-for="Address" class="dh-input" />
            <div class="dh-form-error"><span asp-validation-for="Address"></span></div>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Telefon" data-en="Phone">Telefon</label>
            <input asp-for="PhoneNumber" class="dh-input" />
        </div>
        <div style="display:flex;gap:.75rem;margin-top:1rem;">
            <button type="submit" class="dh-btn dh-btn-primary"><i class="fa-solid fa-floppy-disk"></i> <span data-pl="Zapisz" data-en="Save">Zapisz</span></button>
            <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
