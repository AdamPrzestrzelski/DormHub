@model IEnumerable<DormHub.Models.BuildingModel>
@{ ViewData["Title"] = "Budynki"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-building" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Budynki" data-en="Buildings">Budynki</span></div>
    <a asp-action="Create" class="dh-btn dh-btn-primary">
        <i class="fa-solid fa-plus"></i>
        <span data-pl="Dodaj budynek" data-en="Add building">Dodaj budynek</span>
    </a>
</div>

<div class="dh-card dh-fade dh-fade-1">
    <div style="overflow-x:auto;">
        <table class="dh-table">
            <thead>
                <tr>
                    <th data-pl="Nazwa" data-en="Name">Nazwa</th>
                    <th data-pl="Adres" data-en="Address">Adres</th>
                    <th data-pl="Piętra" data-en="Floors">Piętra</th>
                    <th data-pl="Telefon" data-en="Phone">Telefon</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="td-bold">@item.Name</td>
                        <td class="td-muted">@item.Address</td>
                        <td class="td-muted">@item.TotalFloors</td>
                        <td class="td-muted">@(item.PhoneNumber ?? "–")</td>
                        <td>
                            <div class="dh-table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="dh-btn dh-btn-danger dh-btn-sm"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
