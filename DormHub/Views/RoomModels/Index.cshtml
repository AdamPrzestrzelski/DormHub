 @model IEnumerable<DormHub.Models.RoomModel>
@{ ViewData["Title"] = "Pokoje"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-door-open" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Pokoje" data-en="Rooms">Pokoje</span></div>
    <a asp-action="Create" class="dh-btn dh-btn-primary">
        <i class="fa-solid fa-plus"></i>
        <span data-pl="Dodaj pokój" data-en="Add room">Dodaj pokój</span>
    </a>
</div>

<div class="dh-card dh-fade dh-fade-1">
    <div style="overflow-x:auto;">
        <table class="dh-table">
            <thead>
                <tr>
                    <th data-pl="Nr pokoju" data-en="Room no.">Nr pokoju</th>
                    <th data-pl="Budynek" data-en="Building">Budynek</th>
                    <th data-pl="Typ" data-en="Type">Typ</th>
                    <th data-pl="Piętro" data-en="Floor">Piętro</th>
                    <th data-pl="Status" data-en="Status">Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="td-bold">#@item.RoomNumber</td>
                        <td class="td-muted">@(item.Building?.Name ?? "–")</td>
                        <td class="td-muted">@(item.RoomType?.Name ?? "–")</td>
                        <td class="td-muted">@item.Floor</td>
                        <td>
                            @{
                                var statusName = item.Status?.Name ?? "–";
                                var badgeClass = item.Status?.Id switch {
                                    1 => "dh-badge-green",
                                    2 => "dh-badge-orange",
                                    3 => "dh-badge-yellow",
                                    4 => "dh-badge-blue",
                                    _ => "dh-badge-gray"
                                };
                            }
                            <span class="dh-badge @badgeClass">@statusName</span>
                        </td>
                        <td>
                            <div class="dh-table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="dh-btn dh-btn-danger dh-btn-sm"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
