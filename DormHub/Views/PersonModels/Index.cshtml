@model IEnumerable<DormHub.Models.PersonModel>
@{
    ViewData["Title"] = "Osoby";
    var housed = ViewBag.HousedPersonIds as List<int> ?? new List<int>();
}

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-users" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Osoby" data-en="Persons">Osoby</span></div>
    <a asp-action="Create" class="dh-btn dh-btn-primary">
        <i class="fa-solid fa-plus"></i>
        <span data-pl="Dodaj osobę" data-en="Add person">Dodaj osobę</span>
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="dh-card dh-fade" style="border-left:4px solid var(--green);margin-bottom:1rem;">
        <i class="fa-solid fa-circle-check" style="color:var(--green);margin-right:.5rem;"></i>@TempData["Success"]
    </div>
}

<div class="dh-card dh-fade dh-fade-1">
    <div style="overflow-x:auto;">
        <table class="dh-table">
            <thead>
                <tr>
                    <th data-pl="Imię i nazwisko" data-en="Full name">Imię i nazwisko</th>
                    <th data-pl="E-mail" data-en="Email">E-mail</th>
                    <th data-pl="Telefon" data-en="Phone">Telefon</th>
                    <th data-pl="Data urodzenia" data-en="Date of birth">Data urodzenia</th>
                    <th data-pl="Rola" data-en="Role">Rola</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="td-bold">@item.FirstName @item.LastName</td>
                        <td class="td-muted">@item.Email</td>
                        <td class="td-muted">@item.PhoneNumber</td>
                        <td class="td-muted">@item.DateOfBirth.ToString("dd.MM.yyyy")</td>
                        <td>
                            @{
                                var (rc, rl) = item.Role switch {
                                    "Admin"    => ("dh-badge-red",    "Admin"),
                                    "Resident" => ("dh-badge-green",  "Mieszkaniec"),
                                    _          => ("dh-badge-gray",   item.Role ?? "–")
                                };
                            }
                            <span class="dh-badge @rc">@rl</span>
                        </td>
                        <td>
                            <div class="dh-table-actions">
                                @if (item.Role != "Admin" && !housed.Contains(item.Id))
                                {
                                    <a asp-controller="ResidentModels" asp-action="AssignRoomToPerson" asp-route-personId="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm" title="Przydziel pokój"><i class="fa-solid fa-house-circle-check"></i></a>
                                }
                                <a asp-action="Edit" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="dh-btn dh-btn-danger dh-btn-sm"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
