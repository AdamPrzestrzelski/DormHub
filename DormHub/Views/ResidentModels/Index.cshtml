@model IEnumerable<DormHub.Models.ResidentModel>
@{ ViewData["Title"] = "Mieszkańcy"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-user-group" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Mieszkańcy" data-en="Residents">Mieszkańcy</span></div>
    <a asp-action="Create" class="dh-btn dh-btn-primary">
        <i class="fa-solid fa-plus"></i>
        <span data-pl="Dodaj mieszkańca" data-en="Add resident">Dodaj mieszkańca</span>
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="dh-card dh-fade" style="border-left:4px solid var(--green);margin-bottom:1rem;">
        <i class="fa-solid fa-circle-check" style="color:var(--green);margin-right:.5rem;"></i>@TempData["Success"]
    </div>
}

<div class="dh-card dh-fade dh-fade-1">
    <div style="overflow-x:auto;">
        <table class="dh-table">
            <thead>
                <tr>
                    <th data-pl="Imię i nazwisko" data-en="Full name">Imię i nazwisko</th>
                    <th data-pl="Pokój" data-en="Room">Pokój</th>
                    <th data-pl="E-mail" data-en="Email">E-mail</th>
                    <th data-pl="Zameldowanie" data-en="Move-in">Zameldowanie</th>
                    <th data-pl="Wymeldowanie" data-en="Move-out">Wymeldowanie</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="td-bold">@item.Person?.FirstName @item.Person?.LastName</td>
                        <td class="td-muted">@(item.Room?.RoomNumber.ToString() ?? "–")</td>
                        <td class="td-muted">@item.Person?.Email</td>
                        <td class="td-muted">@item.MoveInDate.ToString("dd.MM.yyyy")</td>
                        <td class="td-muted">@(item.MoveOutDate.HasValue ? item.MoveOutDate.Value.ToString("dd.MM.yyyy") : "–")</td>
                        <td>
                            <div class="dh-table-actions">
                                <a asp-action="AssignRoom" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm" title="Przydziel pokój"><i class="fa-solid fa-house-circle-check"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="dh-btn dh-btn-ghost dh-btn-sm"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="dh-btn dh-btn-danger dh-btn-sm"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
