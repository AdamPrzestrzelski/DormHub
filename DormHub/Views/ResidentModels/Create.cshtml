@{
    ViewData["Title"] = "Dodaj mieszkańca";
}

<div class="dh-page-header dh-fade">
    <div class="dh-page-title">
        <i class="fa-solid fa-user-plus" style="color:var(--orange);margin-right:.5rem;"></i>
        <span data-pl="Dodaj mieszkańca" data-en="Add resident">Dodaj mieszkańca</span>
    </div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost">
        <i class="fa-solid fa-arrow-left"></i>
        <span data-pl="Powrót" data-en="Back">Powrót</span>
    </a>
</div>

<div class="dh-card dh-fade dh-fade-1" style="max-width:540px;">
    <p style="font-size:.85rem;color:var(--muted);margin-bottom:1.25rem;" data-pl="Wybierz istniejącą osobę z systemu i przypisz jej pokój oraz daty zameldowania." data-en="Select an existing person and assign a room and check-in dates.">
        Wybierz istniejącą osobę z systemu i przypisz jej pokój oraz daty zameldowania.
    </p>
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Osoba" data-en="Person">Osoba</label>
            <select name="PersonId" class="dh-select" asp-items="ViewBag.PersonId" required>
                <option value="">-- wybierz osobę --</option>
            </select>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Pokój" data-en="Room">Pokój</label>
            <select name="RoomId" class="dh-select" asp-items="ViewBag.RoomId">
                <option value="">-- brak / przydziel później --</option>
            </select>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Data zameldowania" data-en="Move-in date">Data zameldowania</label>
                <input name="MoveInDate" class="dh-input" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Data wymeldowania" data-en="Move-out date">Data wymeldowania</label>
                <input name="MoveOutDate" class="dh-input" type="date" />
            </div>
        </div>
        <div style="display:flex;gap:.75rem;margin-top:1rem;">
            <button type="submit" class="dh-btn dh-btn-primary">
                <i class="fa-solid fa-floppy-disk"></i>
                <span data-pl="Zapisz" data-en="Save">Zapisz</span>
            </button>
            <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
        </div>
    </form>
</div>
