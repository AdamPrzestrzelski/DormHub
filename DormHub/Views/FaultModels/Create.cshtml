@model DormHub.Models.FaultModel
@{ ViewData["Title"] = "Zgłoś usterkę"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-wrench" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Zgłoś usterkę" data-en="Report fault">Zgłoś usterkę</span></div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost"><i class="fa-solid fa-arrow-left"></i> <span data-pl="Powrót" data-en="Back">Powrót</span></a>
</div>

@if (TempData["Error"] != null)
{
    <div class="dh-validation-summary">@TempData["Error"]</div>
}

<div class="dh-card dh-fade dh-fade-1" style="max-width:620px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="dh-validation-summary"></div>

        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Pokój" data-en="Room">Pokój</label>
                <select asp-for="RoomId" class="dh-select" asp-items="ViewBag.RoomId">
                    <option value="">-- wybierz --</option>
                </select>
            </div>
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Zgłaszający" data-en="Reported by">Zgłaszający</label>
                <select asp-for="ReportedById" class="dh-select" asp-items="ViewBag.ReportedById">
                    <option value="">-- wybierz --</option>
                </select>
            </div>
        }

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Kategoria" data-en="Category">Kategoria</label>
                <select asp-for="CategoryId" class="dh-select" asp-items="ViewBag.CategoryId">
                    <option value="">-- wybierz --</option>
                </select>
            </div>
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Priorytet" data-en="Priority">Priorytet</label>
                <select asp-for="PriorityId" class="dh-select" asp-items="ViewBag.PriorityId">
                    <option value="">-- wybierz --</option>
                </select>
            </div>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Opis usterki" data-en="Fault description">Opis usterki</label>
            <textarea asp-for="Description" class="dh-textarea" rows="4" placeholder="Opisz problem..."></textarea>
            <div class="dh-form-error"><span asp-validation-for="Description"></span></div>
        </div>
        <div style="display:flex;gap:.75rem;margin-top:1rem;">
            <button type="submit" class="dh-btn dh-btn-primary"><i class="fa-solid fa-floppy-disk"></i> <span data-pl="Zgłoś" data-en="Submit">Zgłoś</span></button>
            <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
