@model DormHub.Models.AnnouncementModel
@{ ViewData["Title"] = "Nowe ogłoszenie"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-bullhorn" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Nowe ogłoszenie" data-en="New announcement">Nowe ogłoszenie</span></div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost"><i class="fa-solid fa-arrow-left"></i> <span data-pl="Powrót" data-en="Back">Powrót</span></a>
</div>

<div class="dh-card dh-fade dh-fade-1" style="max-width:600px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="dh-validation-summary"></div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Tytuł" data-en="Title">Tytuł</label>
            <input asp-for="Title" class="dh-input"/>
            <div class="dh-form-error"><span asp-validation-for="Title"></span></div>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Treść" data-en="Content">Treść</label>
            <textarea asp-for="Content" class="dh-textarea" rows="5"></textarea>
            <div class="dh-form-error"><span asp-validation-for="Content"></span></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Autor" data-en="Author">Autor</label>
                <select asp-for="AuthorId" class="dh-select" asp-items="ViewBag.AuthorId">
                    <option value="">-- wybierz --</option>
                </select>
            </div>
            <div class="dh-form-group">
                <label class="dh-label" data-pl="Budynek (puste = wszystkie)" data-en="Building (empty = all)">Budynek</label>
                <select asp-for="BuildingId" class="dh-select" asp-items="ViewBag.BuildingId">
                    <option value="">– Wszystkie –</option>
                </select>
            </div>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Data wygaśnięcia" data-en="Expiry date">Data wygaśnięcia</label>
            <input asp-for="ExpiresAt" class="dh-input" type="date"/>
        </div>
        <div class="dh-form-group">
            <label class="dh-check">
                <input asp-for="IsPinned" type="checkbox"/>
                <span style="font-size:.88rem;color:var(--muted);" data-pl="📌 Przypnij ogłoszenie" data-en="📌 Pin announcement">📌 Przypnij ogłoszenie</span>
            </label>
        </div>
        <div style="display:flex;gap:.75rem;margin-top:1rem;">
            <button type="submit" class="dh-btn dh-btn-primary"><i class="fa-solid fa-paper-plane"></i> <span data-pl="Opublikuj" data-en="Publish">Opublikuj</span></button>
            <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
