@model IEnumerable<DormHub.Models.AnnouncementModel>
@{ ViewData["Title"] = "Ogłoszenia"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-bullhorn" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Ogłoszenia" data-en="Announcements">Ogłoszenia</span></div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="dh-btn dh-btn-primary">
            <i class="fa-solid fa-plus"></i>
            <span data-pl="Nowe ogłoszenie" data-en="New announcement">Nowe ogłoszenie</span>
        </a>
    }
</div>

<div class="dh-fade dh-fade-1" style="display:flex;flex-direction:column;gap:1rem;">
    @if (!Model.Any())
    {
        <div class="dh-card" style="color:var(--muted);text-align:center;padding:3rem;">
            <i class="fa-solid fa-bullhorn" style="font-size:2rem;color:var(--border);margin-bottom:1rem;display:block;"></i>
            <span data-pl="Brak ogłoszeń." data-en="No announcements.">Brak ogłoszeń.</span>
        </div>
    }
    else
    {
        @foreach (var a in Model)
        {
            <div class="dh-card @(a.IsPinned ? "" : "")">
                <div style="display:flex;align-items:flex-start;gap:1rem;">
                    <div class="dh-ann-icon" style="flex-shrink:0;">
                        <i class="fa-solid @(a.IsPinned ? "fa-thumbtack" : "fa-bullhorn")"></i>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.35rem;flex-wrap:wrap;">
                            <span style="font-weight:700;color:#fff;font-size:1rem;">@a.Title</span>
                            @if (a.IsPinned)
                            {
                                <span class="dh-badge dh-badge-orange" data-pl="Przypięte" data-en="Pinned">Przypięte</span>
                            }
                            @if (a.Building != null)
                            {
                                <span class="dh-ann-tag">@a.Building.Name</span>
                            }
                        </div>
                        <p style="color:var(--muted);font-size:.88rem;line-height:1.6;margin:0 0 .6rem;">@a.Content</p>
                        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
                            <span class="dh-ann-time"><i class="fa-regular fa-clock"></i> @a.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            @if (a.ExpiresAt.HasValue)
                            {
                                <span class="dh-ann-time"><i class="fa-solid fa-calendar-xmark"></i>
                                    <span data-pl="Ważne do:" data-en="Expires:">Ważne do:</span> @a.ExpiresAt.Value.ToString("dd.MM.yyyy")</span>
                            }
                        </div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@a.Id" class="dh-btn dh-btn-danger dh-btn-sm" style="flex-shrink:0;"><i class="fa-solid fa-trash"></i></a>
                    }
                </div>
            </div>
        }
    }
</div>
