@model DormHub.Models.ResourceModel
@{ ViewData["Title"] = "Usuń zasób"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title">
        <i class="fa-solid fa-trash" style="color:var(--red,#f87171);margin-right:.5rem;"></i>
        <span data-pl="Usuń zasób" data-en="Delete resource">Usuń zasób</span>
    </div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost">
        <i class="fa-solid fa-arrow-left"></i>
        <span data-pl="Powrót" data-en="Back">Powrót</span>
    </a>
</div>

<div class="dh-card dh-fade dh-fade-1" style="max-width:480px;">
    <p style="color:var(--muted);margin-bottom:1.25rem;" data-pl="Czy na pewno chcesz usunąć ten zasób? Operacja jest nieodwracalna." data-en="Are you sure you want to delete this resource? This cannot be undone.">
        Czy na pewno chcesz usunąć ten zasób? Operacja jest nieodwracalna.
    </p>
    <div class="dh-card" style="background:var(--surface2);margin-bottom:1.5rem;">
        <p><strong data-pl="Nazwa:" data-en="Name:">Nazwa:</strong> @Model.Name</p>
        <p><strong data-pl="Kategoria:" data-en="Category:">Kategoria:</strong> @Model.Category</p>
        <p><strong data-pl="Budynek:" data-en="Building:">Budynek:</strong> @Model.Building?.Name</p>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div style="display:flex;gap:.75rem;">
            <button type="submit" class="dh-btn dh-btn-danger">
                <i class="fa-solid fa-trash"></i>
                <span data-pl="Usuń" data-en="Delete">Usuń</span>
            </button>
            <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
        </div>
    </form>
</div>
