@model DormHub.Models.ApplicationModel
@{ ViewData["Title"] = "Edytuj wniosek"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-pen" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Edytuj wniosek" data-en="Edit application">Edytuj wniosek</span></div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost"><i class="fa-solid fa-arrow-left"></i> <span data-pl="Powrót" data-en="Back">Powrót</span></a>
</div>

<div class="dh-card dh-fade dh-fade-1" style="max-width:560px;">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="dh-validation-summary"></div>
        <input type="hidden" asp-for="Id" />
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Wnioskodawca" data-en="Applicant">Wnioskodawca</label>
            <select asp-for="ApplicantId" class="dh-select" asp-items="ViewBag.ApplicantId">
                <option value="">-- wybierz --</option>
            </select>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Typ wniosku" data-en="Application type">Typ wniosku</label>
            <select asp-for="TypeId" class="dh-select" asp-items="ViewBag.TypeId"></select>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Preferowany typ pokoju" data-en="Preferred room type">Preferowany typ pokoju</label>
            <select asp-for="PreferredRoomTypeId" class="dh-select" asp-items="ViewBag.PreferredRoomTypeId">
                <option value="">-- dowolny --</option>
            </select>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Preferowany budynek" data-en="Preferred building">Preferowany budynek</label>
            <select asp-for="PreferredBuildingId" class="dh-select" asp-items="ViewBag.PreferredBuildingId">
                <option value="">-- dowolny --</option>
            </select>
        </div>
        <div style="display:flex;gap:.75rem;">
            <div class="dh-form-group" style="flex:1;">
                <label class="dh-label" data-pl="Data rozpoczęcia" data-en="Start date">Data rozpoczęcia</label>
                <input asp-for="PreferredStartDate" class="dh-input" type="date" />
            </div>
            <div class="dh-form-group" style="flex:1;">
                <label class="dh-label" data-pl="Data zakończenia" data-en="End date">Data zakończenia</label>
                <input asp-for="PreferredEndDate" class="dh-input" type="date" />
            </div>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Opis / uwagi" data-en="Description / notes">Opis / uwagi</label>
            <textarea asp-for="Description" class="dh-input" rows="3"></textarea>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Status" data-en="Status">Status</label>
            <select asp-for="StatusId" class="dh-select" asp-items="ViewBag.StatusId"></select>
        </div>
        <div style="display:flex;gap:.75rem;margin-top:1rem;">
            <button type="submit" class="dh-btn dh-btn-primary"><i class="fa-solid fa-floppy-disk"></i> <span data-pl="Zapisz" data-en="Save">Zapisz</span></button>
            <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
