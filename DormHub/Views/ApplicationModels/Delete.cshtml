@model DormHub.Models.ApplicationModel
@{ ViewData["Title"] = "Usuń wniosek"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-trash" style="color:var(--red);margin-right:.5rem;"></i><span data-pl="Usuń wniosek" data-en="Delete application">Usuń wniosek</span></div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost"><i class="fa-solid fa-arrow-left"></i> <span data-pl="Powrót" data-en="Back">Powrót</span></a>
</div>

<div class="dh-card dh-fade dh-fade-1" style="max-width:560px;">
    <p data-pl="Czy na pewno chcesz usunąć ten wniosek?" data-en="Are you sure you want to delete this application?">Czy na pewno chcesz usunąć ten wniosek?</p>
    <dl style="display:grid;grid-template-columns:auto 1fr;gap:.5rem 1.5rem;">
        <dt class="td-muted" data-pl="Wnioskodawca" data-en="Applicant">Wnioskodawca</dt>
        <dd class="td-bold">@(Model.Applicant == null ? "–" : Model.Applicant.FirstName + " " + Model.Applicant.LastName)</dd>
        <dt class="td-muted" data-pl="Typ wniosku" data-en="Type">Typ wniosku</dt>
        <dd>@(Model.Type?.Name ?? "–")</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="margin-top:1rem;">
        @Html.AntiForgeryToken()
        <button type="submit" class="dh-btn dh-btn-danger"><i class="fa-solid fa-trash"></i> <span data-pl="Usuń" data-en="Delete">Usuń</span></button>
        <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
    </form>
</div>
