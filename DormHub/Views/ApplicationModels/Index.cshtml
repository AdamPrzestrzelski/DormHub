@model IEnumerable<DormHub.Models.ApplicationModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Applicant)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PreferredRoomType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PreferredBuilding)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.Applicant == null ? "" : item.Applicant.FirstName + " " + item.Applicant.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PreferredRoomType.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PreferredBuilding.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
