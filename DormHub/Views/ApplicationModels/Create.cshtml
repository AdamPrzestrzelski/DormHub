@model DormHub.Models.ApplicationModel
@{ ViewData["Title"] = "Nowy wniosek"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title"><i class="fa-solid fa-clipboard-list" style="color:var(--orange);margin-right:.5rem;"></i><span data-pl="Nowy wniosek" data-en="New application">Nowy wniosek</span></div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost"><i class="fa-solid fa-arrow-left"></i> <span data-pl="Powrót" data-en="Back">Powrót</span></a>
</div>

<div class="dh-card dh-fade dh-fade-1" style="max-width:560px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="dh-validation-summary"></div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Wnioskodawca" data-en="Applicant">Wnioskodawca</label>
            <select asp-for="ApplicantId" class="dh-select" asp-items="ViewBag.ApplicantId">
                <option value="">-- wybierz --</option>
            </select>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Preferowany typ pokoju" data-en="Preferred room type">Preferowany typ pokoju</label>
            <select asp-for="PreferredRoomTypeId" class="dh-select" asp-items="ViewBag.PreferredRoomTypeId">
                <option value="">-- dowolny --</option>
            </select>
        </div>
        <div class="dh-form-group">
            <label class="dh-label" data-pl="Preferowany budynek" data-en="Preferred building">Preferowany budynek</label>
            <select asp-for="PreferredBuildingId" class="dh-select" asp-items="ViewBag.PreferredBuildingId">
                <option value="">-- dowolny --</option>
            </select>
        </div>
        <div style="display:flex;gap:.75rem;margin-top:1rem;">
            <button type="submit" class="dh-btn dh-btn-primary"><i class="fa-solid fa-paper-plane"></i> <span data-pl="Wyślij wniosek" data-en="Submit">Wyślij wniosek</span></button>
            <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
