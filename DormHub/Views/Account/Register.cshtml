@model DormHub.Models.RegisterViewModel
@{
    ViewData["Title"] = "Rejestracja";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pl" id="html-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Rejestracja – DormHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="dh-login-body">

<div class="dh-login-card" style="max-width:520px;">
    <div class="dh-login-logo">
        <div class="dh-logo-icon">
            <i class="fa-solid fa-building"></i>
        </div>
        <span class="dh-logo-text">Dorm<span>Hub</span></span>
    </div>

    <h2 class="dh-login-title" data-pl="Załóż konto" data-en="Create account">Załóż konto</h2>
    <p class="dh-login-sub" data-pl="Zarejestruj się, aby móc składać wnioski o miejsce w akademiku." data-en="Sign up to submit dormitory applications.">
        Zarejestruj się, aby móc składać wnioski o miejsce w akademiku.
    </p>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="dh-validation-summary"></div>

        <div style="display:flex;gap:.75rem;">
            <div class="dh-form-group" style="flex:1;">
                <label class="dh-label" data-pl="Imię" data-en="First name">Imię</label>
                <input asp-for="FirstName" class="dh-input" />
                <div class="dh-form-error"><span asp-validation-for="FirstName"></span></div>
            </div>
            <div class="dh-form-group" style="flex:1;">
                <label class="dh-label" data-pl="Nazwisko" data-en="Last name">Nazwisko</label>
                <input asp-for="LastName" class="dh-input" />
                <div class="dh-form-error"><span asp-validation-for="LastName"></span></div>
            </div>
        </div>

        <div class="dh-form-group">
            <label class="dh-label" data-pl="Data urodzenia" data-en="Date of birth">Data urodzenia</label>
            <input asp-for="DateOfBirth" class="dh-input" type="date" />
            <div class="dh-form-error"><span asp-validation-for="DateOfBirth"></span></div>
        </div>

        <div class="dh-form-group">
            <label class="dh-label" data-pl="Adres e-mail" data-en="Email address">Adres e-mail</label>
            <input asp-for="Email" class="dh-input" type="email" placeholder="twoj@email.com" />
            <div class="dh-form-error"><span asp-validation-for="Email"></span></div>
        </div>

        <div class="dh-form-group">
            <label class="dh-label" data-pl="Numer telefonu" data-en="Phone number">Numer telefonu</label>
            <input asp-for="PhoneNumber" class="dh-input" />
            <div class="dh-form-error"><span asp-validation-for="PhoneNumber"></span></div>
        </div>

        <div style="display:flex;gap:.75rem;">
            <div class="dh-form-group" style="flex:1;">
                <label class="dh-label" data-pl="Hasło" data-en="Password">Hasło</label>
                <input asp-for="Password" class="dh-input" type="password" placeholder="••••••••" />
                <div class="dh-form-error"><span asp-validation-for="Password"></span></div>
            </div>
            <div class="dh-form-group" style="flex:1;">
                <label class="dh-label" data-pl="Potwierdź hasło" data-en="Confirm password">Potwierdź hasło</label>
                <input asp-for="ConfirmPassword" class="dh-input" type="password" placeholder="••••••••" />
                <div class="dh-form-error"><span asp-validation-for="ConfirmPassword"></span></div>
            </div>
        </div>

        <button type="submit" class="dh-btn dh-btn-primary" style="width:100%;justify-content:center;padding:.75rem;">
            <i class="fa-solid fa-user-plus"></i>
            <span data-pl="Zarejestruj się" data-en="Sign up">Zarejestruj się</span>
        </button>
    </form>

    <p style="text-align:center;margin-top:1.25rem;font-size:.9rem;color:var(--muted);">
        <span data-pl="Masz już konto?" data-en="Already have an account?">Masz już konto?</span>
        <a asp-controller="Account" asp-action="Login" style="color:var(--orange);font-weight:600;text-decoration:none;">
            <span data-pl="Zaloguj się" data-en="Sign in">Zaloguj się</span>
        </a>
    </p>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
