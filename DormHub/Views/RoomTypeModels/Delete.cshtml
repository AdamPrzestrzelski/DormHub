@model DormHub.Models.RoomTypeModel
@{ ViewData["Title"] = "Usuń typ pokoju"; }

<div class="dh-page-header dh-fade">
    <div class="dh-page-title">
        <i class="fa-solid fa-trash" style="color:var(--danger);margin-right:.5rem;"></i>
        <span data-pl="Usuń typ pokoju" data-en="Delete room type">Usuń typ pokoju</span>
    </div>
    <a asp-action="Index" class="dh-btn dh-btn-ghost">
        <i class="fa-solid fa-arrow-left"></i> <span data-pl="Powrót" data-en="Back">Powrót</span>
    </a>
</div>

<div class="dh-card dh-fade dh-fade-1" style="max-width:480px;">
    <p style="color:var(--danger);font-weight:600;margin-bottom:1rem;">
        <i class="fa-solid fa-triangle-exclamation"></i>
        Czy na pewno chcesz usunąć ten typ pokoju?
    </p>
    <dl style="display:grid;grid-template-columns:auto 1fr;gap:.6rem 1.5rem;margin-bottom:1.5rem;">
        <dt class="td-muted">Nazwa</dt>
        <dd style="margin:0;font-weight:600;">@Model.Name</dd>

        <dt class="td-muted">Pojemność</dt>
        <dd style="margin:0;">@Model.Capacity os.</dd>

        <dt class="td-muted">Cena / miesiąc</dt>
        <dd style="margin:0;font-weight:600;">@Model.PricePerMonth.ToString("N2") PLN</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div style="display:flex;gap:.75rem;">
            <button type="submit" class="dh-btn dh-btn-danger">
                <i class="fa-solid fa-trash"></i> <span data-pl="Usuń" data-en="Delete">Usuń</span>
            </button>
            <a asp-action="Index" class="dh-btn dh-btn-ghost" data-pl="Anuluj" data-en="Cancel">Anuluj</a>
        </div>
    </form>
</div>
