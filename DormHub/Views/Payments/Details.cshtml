@model DormHub.Models.PaymentModel

@{
    ViewData["Title"] = "Szczegóły płatności";
}

<h1>💰 Szczegóły płatności</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Mieszkaniec</dt>
    <dd class="col-sm-9">@Model.Resident?.FirstName @Model.Resident?.LastName</dd>

    <dt class="col-sm-3">Opis</dt>
    <dd class="col-sm-9">@(Model.Description ?? "–")</dd>

    <dt class="col-sm-3">Kwota</dt>
    <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

    <dt class="col-sm-3">Termin płatności</dt>
    <dd class="col-sm-9">@Model.DueDate.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @{
            var (cls, lbl) = Model.Status switch {
                DormHub.Models.PaymentStatus.Paid    => ("bg-success", "Zapłacona"),
                DormHub.Models.PaymentStatus.Overdue => ("bg-danger",  "Zaległa"),
                _                                     => ("bg-warning text-dark", "Oczekująca")
            };
        }
        <span class="badge @cls">@lbl</span>
    </dd>

    <dt class="col-sm-3">Data zapłaty</dt>
    <dd class="col-sm-9">@(Model.PaidAt.HasValue ? Model.PaidAt.Value.ToString("dd.MM.yyyy HH:mm") : "–")</dd>

    <dt class="col-sm-3">Utworzono</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">← Powrót</a>
